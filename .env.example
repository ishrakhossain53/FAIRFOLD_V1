# Copy to .env for local development. Never commit the real file.

NODE_ENV=development
APP_URL=http://localhost:3000

# Postgres — system of record
DATABASE_URL=postgresql://user:pass@localhost:5432/verified_skills

# Redis — job queue and GitHub response cache
REDIS_URL=redis://localhost:6379

# Private S3-compatible bucket for CVs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# GitHub OAuth app — read-only public scopes, separate app per environment
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sessions
JWT_SECRET=
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Encrypts stored GitHub tokens (32-byte base64)
TOKEN_ENCRYPTION_KEY=

# CV extraction — provider undecided, see decision D5
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Worker
WORKER_CONCURRENCY=4
GITHUB_MAX_REPOS_PER_SCAN=100
